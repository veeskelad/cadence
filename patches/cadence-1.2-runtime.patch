@@ -0,0 +1,27 @@
+// Запуск локального CLI без shell-синтаксиса VAR=1 и платформенных .cmd-обёрток.
+import {spawnSync} from 'node:child_process';
+import {existsSync, readFileSync} from 'node:fs';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+
+const packagePath = fileURLToPath(new URL('./node_modules/hyperframes/package.json', import.meta.url));
+
+try {
+  const pkg = JSON.parse(readFileSync(packagePath, 'utf8'));
+  const bin = typeof pkg.bin === 'string' ? pkg.bin : pkg.bin?.hyperframes;
+  if (typeof bin !== 'string' || !bin) throw new Error('В пакете нет CLI hyperframes');
+  const entry = path.resolve(path.dirname(packagePath), bin);
+  if (!existsSync(entry)) throw new Error(`Нет файла CLI: ${entry}`);
+
+  const result = spawnSync(process.execPath, [entry, ...process.argv.slice(2)], {
+    stdio: 'inherit',
+    env: {...process.env, HYPERFRAMES_NO_TELEMETRY: '1', DO_NOT_TRACK: '1'},
+  });
+  if (result.error) throw result.error;
+  if (result.signal) console.error(`HyperFrames остановлен сигналом ${result.signal}`);
+  process.exitCode = result.status ?? 1;
+} catch (error) {
+  console.error(`Не удалось запустить локальный HyperFrames: ${error.message}`);
+  console.error('Проверь установку движка: npm --prefix engine install (нужна сеть и согласие).');
+  process.exitCode = 1;
+}
diff --git a/engine/safe-build.mjs b/engine/safe-build.mjs
new file mode 100644
--- /dev/null
+++ b/engine/safe-build.mjs
@@ -0,0 +1,92 @@
+// Только явно принадлежащую Cadence папку сборки можно очищать при повторном запуске.
+// Маркер привязан к реальному пути: копия маркера не делает чужую папку сборкой.
+import {lstat, mkdir, readFile, realpath, rm, writeFile} from 'node:fs/promises';
+import {homedir} from 'node:os';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+
+const MARKER = '.cadence-build.json';
+const runtimeRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const within = (parent, child) => {
+  const relative = path.relative(parent, child);
+  return relative === '' || (!relative.startsWith(`..${path.sep}`) && relative !== '..' && !path.isAbsolute(relative));
+};
+const overlap = (a, b) => within(a, b) || within(b, a);
+const statIfPresent = async (file) => {
+  try { return await lstat(file); }
+  catch (error) { if (error.code === 'ENOENT') return null; throw error; }
+};
+
+// realpath также для ещё не существующего назначения; существующие родители могут
+// быть ссылками (включая системный /tmp). Дальше используем только полученный путь.
+async function canonical(file) {
+  const absolute = path.resolve(file);
+  const info = await statIfPresent(absolute);
+  if (info) return realpath(absolute);
+  const parent = path.dirname(absolute);
+  if (parent === absolute) throw new Error(`Не удалось проверить путь ${absolute}`);
+  return path.join(await canonical(parent), path.basename(absolute));
+}
+
+export function defaultWorkDir(root) {
+  const env = process.env.CADENCE_WORK?.trim();
+  if (env) {
+    if (env === '~') return homedir();
+    if (env.startsWith('~/') || (path.sep === '\\' && env.startsWith('~\\'))) return path.resolve(homedir(), env.slice(2));
+    if (env.startsWith('~')) throw new Error('CADENCE_WORK: используй ~/ или абсолютный путь вместо ~имя');
+    return path.resolve(env);
+  }
+  return path.basename(path.dirname(root)) === 'releases' ? path.resolve(root, '../../work') : path.resolve(root, 'work');
+}
+
+export async function assertBuildDirectory({root = runtimeRoot, workDir = defaultWorkDir(root), out, inputs = [], sourceDirs = []}) {
+  const requested = path.resolve(out);
+  const info = await statIfPresent(requested);
+  if (info && (!info.isDirectory() || info.isSymbolicLink())) {
+    throw new Error(`--out ${requested}: нужна отдельная папка сборки, не файл или ссылка`);
+  }
+  const destination = await canonical(requested);
+  const work = await canonical(workDir);
+  if (within(destination, work)) throw new Error(`--out ${requested} перекрывает рабочую папку`);
+  for (const release of new Set([await canonical(root), await canonical(runtimeRoot)])) {
+    // В распакованном наборе допускается только его обычная work/, не код или примеры.
+    // Не разрешаем ссылке work/ → engine/ превратить код в рабочую область.
+    const localWork = path.join(release, 'work');
+    if (within(destination, release) || (within(release, destination) && !within(localWork, destination))) {
+      throw new Error(`--out ${requested} перекрывает сам набор или его исходники`);
+    }
+  }
+  for (const source of sourceDirs) {
+    if (overlap(destination, await canonical(source))) throw new Error(`--out ${requested} перекрывает исходники: ${source}`);
+  }
+  for (const input of inputs.filter(Boolean)) {
+    if (overlap(destination, await canonical(input))) throw new Error(`--out ${requested} перекрывает входной файл: ${input}`);
+  }
+  if (info) {
+    const marker = path.join(destination, MARKER);
+    const markerInfo = await statIfPresent(marker);
+    let owner;
+    if (markerInfo?.isFile() && !markerInfo.isSymbolicLink()) {
+      try { owner = JSON.parse(await readFile(marker, 'utf8')); }
+      catch (error) { if (error.code && error.code !== 'ENOENT') throw error; }
+    }
+    if (owner?.type !== 'cadence-build' || owner.version !== 1 || owner.path !== destination) {
+      throw new Error(`--out ${requested}: папка уже существует и не является отмеченной сборкой Cadence; выбери новую папку (старую не удаляю)`);
+    }
+  }
+  return destination;
+}
+
+export async function prepareBuildDirectory(options) {
+  const destination = await assertBuildDirectory(options);
+  if (await statIfPresent(destination)) {
+    // Повторная проверка непосредственно перед удалением; ссылки внутри rm не обходит.
+    await assertBuildDirectory({...options, out: destination});
+    await rm(destination, {recursive: true});
+  }
+  await mkdir(path.dirname(destination), {recursive: true});
+  // Не присваиваем себе папку, которая появилась после проверки.
+  await mkdir(destination);
+  await writeFile(path.join(destination, MARKER), JSON.stringify({type: 'cadence-build', version: 1, path: destination}) + '\n', {flag: 'wx'});
+  return destination;
+}
