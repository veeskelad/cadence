+// Только временные файлы: без настоящего HyperFrames, сети и пользовательских материалов.
+import assert from 'node:assert/strict';
+import {spawnSync} from 'node:child_process';
+import {cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync} from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import test from 'node:test';
+
+const root = fileURLToPath(new URL('..', import.meta.url));
+const python = process.env.PYTHON || 'python3';
+
+function temp(t) {
+  const dir = realpathSync(mkdtempSync(path.join(os.tmpdir(), 'cadence startup ')));
+  t.after(() => rmSync(dir, {recursive: true, force: true}));
+  return dir;
+}
+
+function cleanEnv(extra = {}) {
+  const env = {...process.env};
+  delete env.CADENCE_WORK;
+  return {...env, ...extra};
+}
+
+function pathsFixture(t, layout = 'unpacked') {
+  const dir = temp(t);
+  const release = path.join(dir, layout === 'release' ? 'Cadence/releases/1.2' : 'unpacked kit');
+  mkdirSync(path.join(release, 'scripts'), {recursive: true});
+  const script = path.join(release, 'scripts/cadence_paths.py');
+  cpSync(path.join(root, 'scripts/cadence_paths.py'), script);
+  return {dir, release, script};
+}
+
+function runPaths(fixture, extra = {}, cwd = fixture.dir) {
+  return spawnSync(python, [fixture.script, 'work-root'], {
+    cwd, env: cleanEnv(extra), encoding: 'utf8',
+  });
+}
+
+test('work-root: direct unpack is based on script location, not current directory', t => {
+  const fixture = pathsFixture(t);
+  const result = runPaths(fixture);
+  assert.equal(result.status, 0, result.stderr);
+  const expected = path.join(fixture.release, 'work');
+  assert.equal(result.stdout.trim(), expected);
+  assert.equal(existsSync(expected), false, 'read-only command must not create work');
+});
+
+test('work-root: releases/id uses shared installation work directory', t => {
+  const fixture = pathsFixture(t, 'release');
+  const result = runPaths(fixture);
+  assert.equal(result.status, 0, result.stderr);
+  assert.equal(result.stdout.trim(), path.join(fixture.dir, 'Cadence/work'));
+  assert.equal(existsSync(path.join(fixture.dir, 'Cadence/work')), false);
+});
+
+test('work-root: absolute CADENCE_WORK wins over installed layout and preserves spaces', t => {
+  const fixture = pathsFixture(t, 'release');
